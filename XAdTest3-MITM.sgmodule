#!name = X去广告测试3-MITM脚本

#!desc = 测试 X iOS GraphQL response 去广告；如开启后全量加载失败，说明疑似证书固定

#!author = dejour

#!homepage=https://yfamilys.com

#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Twitter.png


[Script]
x.response = type=http-response,pattern=^https:\/\/(api\.x\.com|api\.twitter\.com|x\.com|twitter\.com)\/(i\/api\/)?graphql\/[^\/]+\/(HomeTimeline|HomeLatestTimeline|SearchTimeline|ExplorePage|ExploreSidebar|UserTweets|UserTweetsAndReplies|UserMedia|GenericTimelineById|ListLatestTweetsTimeline|ListRankedTweetsTimeline|CommunityTweetsTimeline|UserPromotedTweets),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/dejour/youtube/main/x.response.js

[MITM]
hostname = %APPEND% api.x.com,api.twitter.com,x.com,twitter.com
