#!name = X去广告

#!desc = 屏蔽 X iOS 信息流广告、Promoted 内容和部分广告日志

#!author = dejour

#!homepage=https://yfamilys.com

#!icon = https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Twitter.png


[Rule]
AND,((DOMAIN-SUFFIX,x.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,twitter.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,api.x.com), (PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,api.twitter.com), (PROTOCOL,UDP)),REJECT

[URL Rewrite]
^https:\/\/(api\.x\.com|api\.twitter\.com|x\.com|twitter\.com)\/(i\/api\/)?1\.1\/promoted_content\/log\.json _ reject-200

[Script]
x.response = type=http-response,pattern=^https:\/\/(api\.x\.com|api\.twitter\.com|x\.com|twitter\.com)\/(i\/api\/)?graphql\/[^\/]+\/(HomeTimeline|HomeLatestTimeline|SearchTimeline|ExplorePage|ExploreSidebar|TweetDetail|UserTweets|UserTweetsAndReplies|UserMedia|GenericTimelineById|ListLatestTweetsTimeline|ListRankedTweetsTimeline|CommunityTweetsTimeline|UserPromotedTweets),requires-body=1,max-size=-1,script-path=https://raw.githubusercontent.com/dejour/youtube/main/x.response.js

[MITM]
hostname = %APPEND% api.x.com,api.twitter.com,x.com,*.x.com,twitter.com,*.twitter.com
